<% current_path = assigns[:current_path] || "/dashboard/overview" %>
<% left_nav_items = Backplane.Admin.Layouts.left_nav_items(current_path) %>
<% left_nav_heading = Backplane.Admin.Layouts.left_nav_heading(current_path) %>
<% left_nav_groups = Backplane.Admin.Layouts.left_nav_groups(current_path, assigns[:memory_navigation] || %{}) %>
<% build_info = Backplane.Admin.BuildInfo.current() %>
<% memory_section? = String.starts_with?(current_path, "/memory") %>
<% active_left_item = left_nav_items |> Enum.flat_map(fn item -> Map.get(item, :items, [item]) end) |> Enum.find(&Backplane.Admin.Layouts.active_left_nav?(current_path, &1)) %>
<% memory_page_label = cond do
  active_left_item -> active_left_item.label
  String.starts_with?(current_path, "/memory/events") -> "Events"
  String.starts_with?(current_path, "/memory/streams") -> "Streams"
  true -> "Overview"
end %>

<div class="min-h-full bg-surface text-on-surface">
  <header class="appbar appbar-sticky appbar-primary">
    <div class="flex shrink-0 items-center gap-3">
      <a href={Backplane.WebOrigins.api_url("/")} class="appbar-brand no-underline">
        <img
          src={~p"/images/backplane-logo.png"}
          alt=""
          class="h-10 w-10 aspect-square shrink-0 rounded-md object-contain"
          aria-hidden="true"
        />
        <span class="appbar-title">Backplane</span>
      </a>
      <.dm_tooltip
        id="appbar-version"
        content={Backplane.Admin.BuildInfo.tooltip(build_info)}
        color="secondary"
        position="bottom"
        class="whitespace-pre-line text-left max-w-[calc(100vw-2rem)] break-words"
        :let={trigger_attrs}
      >
        <button
          id="appbar-version-trigger"
          type="button"
          class="cursor-help rounded-full"
          aria-label="Version details"
          {trigger_attrs}
        >
          <.dm_badge
            id="appbar-version-badge"
            variant="secondary"
            size="lg"
            pill
            class="whitespace-nowrap font-medium"
          >
            {Backplane.Admin.BuildInfo.label(build_info)}
          </.dm_badge>
        </button>
      </.dm_tooltip>
    </div>

    <nav class="appbar-actions admin-top-nav" aria-label="Main navigation">
      <.link
        :for={item <- Backplane.Admin.Layouts.top_nav_items()}
        navigate={item.path}
        class={[
          "appbar-action w-auto rounded-md px-3 whitespace-nowrap no-underline",
          Backplane.Admin.Layouts.active_top_nav?(current_path, item.section) &&
            "bg-primary-container text-on-primary-container"
        ]}
        aria-current={Backplane.Admin.Layouts.active_top_nav?(current_path, item.section) && "page"}
      >
        {item.label}
      </.link>
    </nav>

    <div class="appbar-trailing admin-appbar-tools">
    </div>
  </header>

  <div
    id="admin-sidebar-session"
    phx-hook="AdminSidebarSession"
    data-sidebar-collapsed={to_string(@sidebar_collapsed)}
    class="min-h-[calc(100vh-4rem)] bg-surface-container-low lg:flex"
  >
    <.dm_left_menu
      id="admin-sidebar"
      sticky
      socket={@socket}
      groups={left_nav_groups}
      active={Backplane.Admin.Layouts.active_left_nav_id(current_path)}
      nav_label={left_nav_heading <> " navigation"}
      class="admin-sidebar admin-desktop-sidebar sticky top-16 h-[calc(100dvh-4rem)]"
    />

    <aside :if={memory_section?} class="memory-mobile-sidebar lg:hidden">
      <details id="memory-mobile-navigation" class="memory-mobile-menu">
        <summary><span class="text-xs text-on-surface-variant">Memory /</span><span>{memory_page_label}</span><.dm_mdi name="chevron-down" class="ml-auto h-5 w-5" /></summary>
        <nav aria-label="Memory navigation" class="memory-mobile-links">
          <div :for={group <- left_nav_groups} class="memory-mobile-group">
            <span :if={!String.starts_with?(group.id, "links-")} class="memory-eyebrow">{group.label}</span>
            <.link :for={child <- group.items} navigate={child.to} aria-current={Backplane.Admin.Layouts.active_left_nav_id(current_path) == child.id && "page"}>
              <.dm_mdi name={child.icon} class="h-4 w-4" />{child.label}
            </.link>
          </div>
        </nav>
      </details>
    </aside>

    <aside :if={!memory_section?} class="admin-sidebar lg:hidden">
      <nav class="admin-sidebar-nav" aria-label={left_nav_heading <> " navigation"}>
        <div class="admin-sidebar-section">{left_nav_heading}</div>
        <div :for={item <- left_nav_items} class="contents">
          <div :if={Map.has_key?(item, :items)} class="admin-sidebar-group">
            <div class="admin-sidebar-group-title">
              <.dm_mdi :if={item[:icon]} name={item[:icon]} class="admin-sidebar-icon" />
              <span>{item.label}</span>
            </div>
            <.link
              :for={child <- item.items}
              navigate={child.path}
              class={[
                "admin-sidebar-link",
                Backplane.Admin.Layouts.active_left_nav?(current_path, child) && "is-active"
              ]}
              aria-current={Backplane.Admin.Layouts.active_left_nav?(current_path, child) && "page"}
            >
              <.dm_mdi :if={child[:icon]} name={child[:icon]} class="admin-sidebar-icon" />
              <span>{child.label}</span>
            </.link>
          </div>

          <.link
            :if={!Map.has_key?(item, :items)}
            navigate={item.path}
            class={[
              "admin-sidebar-link",
              Backplane.Admin.Layouts.active_left_nav?(current_path, item) && "is-active"
            ]}
            aria-current={Backplane.Admin.Layouts.active_left_nav?(current_path, item) && "page"}
          >
            <.dm_mdi :if={item[:icon]} name={item[:icon]} class="admin-sidebar-icon" />
            <span>{item.label}</span>
          </.link>
        </div>
      </nav>
    </aside>

    <main class={["min-w-0 flex-1 flex flex-col", memory_section? && "memory-workspace"]}>
      <div class="admin-content mx-auto max-w-7xl w-full flex-1 flex flex-col px-4 py-6 sm:px-6 lg:px-8">
        <.dm_flash_group flash={@flash} />
        <.dm_alert :if={assigns[:memory_refresh_error]} id="memory-refresh-error" variant="error" title="Refresh unavailable">{assigns[:memory_refresh_error]}</.dm_alert>
    {@inner_content}
      </div>
    </main>
  </div>
</div>
