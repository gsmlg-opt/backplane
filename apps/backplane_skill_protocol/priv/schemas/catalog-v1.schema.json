{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://backplane.local/skill-protocol/v1/catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "data", "next_cursor"],
  "if": {"required": ["view"]},
  "then": {"properties": {"data": {"items": {"required": ["revision", "artifact_digest", "disable_model_invocation"], "properties": {"revision": {"type":"string", "minLength":1}, "artifact_digest": {"type":"string", "pattern":"^sha256:[0-9a-f]{64}$"}, "publication_status": {"const":"ready"}}}}}},
  "else": {"properties": {"data": {"items": {"not": {"required": ["revision", "artifact_digest", "disable_model_invocation"], "properties": {"revision": {"type":"string", "minLength":1}, "artifact_digest": {"type":"string", "pattern":"^sha256:[0-9a-f]{64}$"}, "publication_status": {"const":"ready"}}}}}}},
  "properties": {
    "view": {"enum": ["always", "search"]},
    "protocol_version": {"const": "1"},
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill_id", "name", "publication_status"],
        "properties": {
          "skill_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": ["string", "null"]},
          "disable_model_invocation": {"type": "boolean"},
          "argument_hint": {"type": ["string", "null"]},
          "revision": {"type": ["string", "null"]},
          "artifact_digest": {"type": ["string", "null"]},
          "publication_status": {"enum": ["ready", "invalid", "pending", "withdrawn"]}
        }
      }
    },
    "next_cursor": {"type": ["string", "null"]}
  }
}
