{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://backplane.local/skill-protocol/v1/catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "data", "next_cursor"],
  "properties": {
    "protocol_version": {"const": "1"},
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill_id", "name", "publication_status"],
        "properties": {
          "skill_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": ["string", "null"]},
          "revision": {"type": ["string", "null"]},
          "artifact_digest": {"type": ["string", "null"]},
          "publication_status": {"enum": ["ready", "invalid", "pending", "withdrawn"]}
        }
      }
    },
    "next_cursor": {"type": ["string", "null"]}
  }
}
