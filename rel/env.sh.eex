#!/bin/sh

if [ "$RELEASE_NAME" = "host_agent" ]; then
  export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"

  case " ${ELIXIR_ERL_OPTIONS:-} " in
    *" -start_epmd false "*) ;;
    *) export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:+$ELIXIR_ERL_OPTIONS }-start_epmd false" ;;
  esac
fi

case "$RELEASE_COMMAND" in
  migrate)
    if [ -n "$2" ]; then
      echo "ERROR: migrate does not accept arguments" >&2
      exit 1
    fi

    exec "$RELEASE_ROOT/bin/$RELEASE_NAME" eval 'Backplane.Release.migrate()'
    ;;
esac
