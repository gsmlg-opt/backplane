{
  "name": "backplane-memory",
  "version": "0.1.0",
  "description": "Backplane shared memory for Codex: capture hooks, memory tools over MCP, and a resident usage instruction.",
  "skills": "./skills",
  "mcpServers": "./.mcp.json",
  "hooks": {
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "__HOOK_CLIENT__ codex SessionStart"
            }
          ]
        }
      ],
      "SessionEnd": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "__HOOK_CLIENT__ codex SessionEnd"
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "__HOOK_CLIENT__ codex UserPromptSubmit"
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "__HOOK_CLIENT__ codex PostToolUse"
            }
          ]
        }
      ],
      "PreCompact": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "__HOOK_CLIENT__ codex PreCompact"
            }
          ]
        }
      ],
      "PostCompact": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "__HOOK_CLIENT__ codex PostCompact"
            }
          ]
        }
      ],
      "SubagentStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "__HOOK_CLIENT__ codex SubagentStart"
            }
          ]
        }
      ],
      "SubagentStop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "__HOOK_CLIENT__ codex SubagentStop"
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "__HOOK_CLIENT__ codex Stop"
            }
          ]
        }
      ]
    }
  }
}
