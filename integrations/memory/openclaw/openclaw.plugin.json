{
  "id": "backplane-memory",
  "kind": "memory",
  "name": "backplane-memory",
  "description": "Backplane memory shared across the user's agents and hosts, via the local Backplane host agent.",
  "version": "1.10.68",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "base_url": {
        "type": "string"
      },
      "agent_id": {
        "type": "string",
        "minLength": 1
      },
      "profile_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "journal_path": {
        "type": "string"
      },
      "token_budget": {
        "type": "integer",
        "minimum": 128,
        "maximum": 32768
      },
      "search_limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      },
      "timeout_ms": {
        "type": "integer",
        "minimum": 100,
        "maximum": 20000
      }
    }
  },
  "uiHints": {
    "enabled": {
      "label": "Enabled"
    },
    "base_url": {
      "label": "Host agent URL"
    },
    "agent_id": {
      "label": "Agent id",
      "help": "Recorded as the agent on memories saved from OpenClaw (default openclaw)."
    },
    "token_budget": {
      "label": "Automatic context budget",
      "help": "128-32768 UTF-8 bytes; includes the header and all labels."
    },
    "search_limit": {
      "label": "Memories searched per turn",
      "help": "1-50; default 8."
    }
  },
  "contracts": {
    "tools": [
      "backplane_memory_search",
      "backplane_memory_get",
      "backplane_memory_recent",
      "backplane_memory_remember",
      "backplane_memory_forget"
    ]
  },
  "toolMetadata": {
    "backplane_memory_search": {
      "replaySafe": true
    },
    "backplane_memory_get": {
      "replaySafe": true
    },
    "backplane_memory_recent": {
      "replaySafe": true
    }
  }
}
